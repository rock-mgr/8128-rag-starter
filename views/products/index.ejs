<%- contentFor('title') %>
Products

<%- contentFor('body') %>

<form action="/products/search" method="get" style="margin-bottom: 20px;">
    <input type="text" name="q" placeholder="Search products by natural language..." style="width: 400px; padding: 8px;" required>
    <button type="submit">Search</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>PDF</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <% results.forEach(function(product){ %>
            <tr>
                <td><%= product.name %></td>
                <td><%= product.description %></td>
                <td><%= product.filename || 'No PDF uploaded' %></td>
                <td>
                    <a href="/products/<%= product.product_id %>">View</a>
                </td>
            </tr>
        <% }); %>
    </tbody>
</table>